{
    "compilerOptions": {
        "paths": {
            "": ["./*"],
            "README.md": ["./README.md"], // 新增：映射根目录的 README.md
            "docs/*": ["./docs/*"],
            ".github/*": ["./.github/*"],
            "src/*": ["./src/*"]
        },
        "emitDecoratorMetadata": true, // optional, 使Reflect类可以添加或读取metadata
        "experimentalDecorators": true, // required
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "ESNext",
        "target": "ES2018",
        "allowJs": true,
        "noImplicitAny": true,
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "importHelpers": true,
        "types": ["node", "jest"],
        "lib": ["dom", "dom.Iterable", "scripthost", "ES5", "ES6", "ES7", "ES2021"],
        "jsx": "react",
        "jsxFactory": "h",
        "noEmit": true
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["build", "coverage", "node_modules"],
    "files": ["node_modules/jest-expect-message/types/index.d.ts"]
}
